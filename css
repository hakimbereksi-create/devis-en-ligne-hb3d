/* Styles minimum pour le viewer JSC3D */
#view3d {
  position: relative;
}

#cv {
  background-color: #f9fafb;
  display: block;
  margin: 0 auto;
}

#tip {
  position: absolute;
  bottom: 10px;
  right: 10px;
  font-size: 0.75rem;
}

#loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
